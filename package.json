{
  "name": "fsandbox",
  "version": "1.0.0",
  "private": true,
  "description": "A React and TypeScript sandbox for validating the build and GitHub Pages deployment path.",
  "homepage": "https://juanmafx.github.io/frontSandBox-/",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "bash -o pipefail -c 'NO_COLOR=1 vitest run --reporter=verbose --reporter=junit --outputFile.junit=reports/tests/junit.xml | sed \"s|$PWD|.|g\" | tee reports/tests/latest-run.txt && sed -i -E \"s| hostname=\\\"[^\\\"]*\\\"||g; s|$PWD|.|g\" reports/tests/junit.xml'",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "npm run build && gh-pages -d build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "gh-pages": "6.3.0",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
